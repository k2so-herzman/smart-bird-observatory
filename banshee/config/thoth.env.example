# Thoth environment file — placeholder template.
#
# Copy to /etc/thoth/env on the LXC and fill in real values:
#   install -m 0640 -o root -g thoth banshee/config/thoth.env.example /etc/thoth/env
#   $EDITOR /etc/thoth/env
#
# Loaded by systemd via EnvironmentFile=/etc/thoth/env on the
# thoth-ingest / thoth-classify / thoth-api services.
#
# Never commit the real /etc/thoth/env to git.

# ---------------------------------------------------------------------------
# MQTT — Home Assistant Mosquitto broker
# ---------------------------------------------------------------------------
MQTT_HOST=192.168.1.73
MQTT_PORT=1883
MQTT_USERNAME=homeassistant-mqtt
MQTT_PASSWORD=__FILL_ME_IN__
MQTT_TOPIC_PREFIX=sbo
MQTT_STATION_FILTER=+
# Optional client id override. Defaults to "thoth-ingest-<hostname>" when unset.
# MQTT_CLIENT_ID=thoth-ingest

# ---------------------------------------------------------------------------
# MinIO — media blob store (bucket `thoth`)
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=http://192.168.1.65:9000
MINIO_ACCESS_KEY=__FILL_ME_IN__
MINIO_SECRET_KEY=__FILL_ME_IN__
MINIO_BUCKET=thoth
# Set to "true" only if you terminate TLS in front of MinIO.
MINIO_SECURE=false

# ---------------------------------------------------------------------------
# imgproxy — public image delivery (unsigned URLs for LAN trust)
# ---------------------------------------------------------------------------
# Pattern: {IMGPROXY_BASE_URL}/unsafe/resize:fit:W:H/format:webp/plain/s3://{MINIO_BUCKET}/<key>
IMGPROXY_BASE_URL=https://images.chickenmilkbomb.com
# If imgproxy later enables signed URLs, set these and flip IMGPROXY_SIGNED=true.
IMGPROXY_SIGNED=false
# IMGPROXY_KEY=
# IMGPROXY_SALT=

# ---------------------------------------------------------------------------
# InfluxDB — time-series metrics (runs in banshee LXC 111)
# ---------------------------------------------------------------------------
INFLUX_URL=http://192.168.1.24:8086
INFLUX_ORG=herzman
INFLUX_BUCKET=sbo
INFLUX_TOKEN=__FILL_ME_IN__

# ---------------------------------------------------------------------------
# SQLite event store
# ---------------------------------------------------------------------------
THOTH_DB_PATH=/var/lib/thoth/events.db

# ---------------------------------------------------------------------------
# API (FastAPI / uvicorn)
# ---------------------------------------------------------------------------
THOTH_API_HOST=127.0.0.1
THOTH_API_PORT=8000
# Floor for the /events listing: events with confidence below this are
# hidden from the default response. Unclassified rows (NULL confidence)
# always pass through. Override per-request via ?min_confidence=; pass 0
# to disable the floor entirely. Defaults to 0.10 to match the horus-side
# classifier floor.
# THOTH_API_MIN_CONFIDENCE=0.10

# ---------------------------------------------------------------------------
# Notifications (populated in a later PR)
# ---------------------------------------------------------------------------
# TELEGRAM_MIN_CONFIDENCE=0.75
# HA_WEBHOOK_URL=
