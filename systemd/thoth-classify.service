[Unit]
Description=Thoth classifier — polls SQLite for pending images, runs TFLite inference
Documentation=https://github.com/k2so-herzman/smart-bird-observatory/blob/main/docs/thoth-design.md
After=network-online.target thoth-ingest.service
Wants=network-online.target

[Service]
Type=simple
User=thoth
Group=thoth
WorkingDirectory=/opt/thoth
EnvironmentFile=/etc/thoth/env
# Polls events WHERE classified_at IS NULL, fetches the blob from
# MinIO, runs the configured Classifier, and writes species/confidence
# back. Falls back to DummyClassifier when THOTH_MODEL_PATH is unset
# (logs a WARNING so it's obvious).
ExecStart=/opt/thoth/venv/bin/thoth-classify
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/thoth /var/log/thoth
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
