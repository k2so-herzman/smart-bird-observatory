[Unit]
Description=Thoth read API — FastAPI (uvicorn) on :8000
Documentation=https://github.com/k2so-herzman/smart-bird-observatory/blob/main/docs/thoth-design.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=thoth
Group=thoth
WorkingDirectory=/opt/thoth
EnvironmentFile=/etc/thoth/env
ExecStart=/opt/thoth/venv/bin/thoth-api
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/thoth /var/log/thoth
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
