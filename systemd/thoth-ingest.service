[Unit]
Description=Thoth ingest — MQTT subscriber, MinIO writer, event store
Documentation=https://github.com/k2so-herzman/smart-bird-observatory/blob/main/docs/thoth-design.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=thoth
Group=thoth
WorkingDirectory=/opt/thoth
EnvironmentFile=/etc/thoth/env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/thoth/venv/bin/thoth-ingest
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/thoth /var/log/thoth
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
